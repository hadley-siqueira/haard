# What a variant IS, which is the half of an enum that lives in this phase.
#
# A variant that carries nothing is **one of the enum** -- 'Colour.red' is a
# 'Colour' -- which is what every language with a sum type says and what makes
# the payload-free enum the degenerate case of the tagged union rather than a
# second feature.
#
# Two of them compare, and the golden's 'same' and 'other' are bool without
# any 'operator==' being written: an enum is a **tag**, not a shape, so there
# is nothing to look up. Only '==' and '!=' -- nothing has said an enum is
# ordered.
#
# A variant that carries a payload is a **constructor**: 'circle : i32' means
# a Shape is built out of an i32, so its type is a signature -- 'i32 -> Shape'
# in the golden -- and 'Shape.circle(1)' is an ordinary call. A tuple payload
# is **flattened**, so 'Click : (i32, i32)' takes two arguments and not one
# tuple, which is the shape Hadley asked for and the one Rust gives a tuple
# variant.
#
# Two payloads are refused, and each says why: one that carries the enum it
# belongs to **by value** (no size -- write a pointer, and nothing allocates
# behind the author's back), and one that carries a class that **cannot be
# copied**, since the union's copy asks each variant to copy what it holds.
#
# A class that owns memory and says how it is copied is carried fine: the
# emitter writes the destructor and the copy that ask the tag which member is
# alive.
enum Colour:
    red
    green
    blue = 7

enum Shape:
    nothing
    circle : i32

class Pen:
    colour : Colour

def takes : i32
    @c : Colour

    return 1

class Owner:
    data : char*

    def init : void
        data = null

    def destroy : void
        pass

enum Expr:
    Number : i32
    Add : (Expr, Expr)

enum Holder:
    Held : Owner

def main : i32
    let c = Colour.red
    let same = c == Colour.red
    let other = c != Colour.green
    let given = takes(Colour.blue)

    let p : Pen

    p.colour = Colour.green

    let empty = Shape.nothing
    let round = Shape.circle(7)

    return given
