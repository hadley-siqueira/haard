# Record 0058. A closure's parameters and what it gives back come from what it
# wrote, and what it did not write comes from the 'A -> R' expected where it
# stands. The locals inside are typed after the parameters, so 'doubled' is an
# i32 because 'x' is one -- and 'x' is one because 'each' said so.

def each : void
    @n : i32
    @f : i32 -> void

    pass

# two overloads told apart by how many parameters the function takes, which is
# all a closure can be asked before one of them wins
def pick : i32
    @f : i32 -> bool

    return 1

def pick : i64
    @f : (i32, i32) -> bool

    return 2

def add_one : i32
    @x : i32

    return x + 1

def main : i32
    let total = 0

    # typed by the sweep before 'x' had a type, 'bigger' would be a call
    # that no 'add_one' takes
    each(3, |x| {
        let doubled = x * 2
        let bigger = add_one(x)
        total += doubled
    })

    let twice = |y: i32| { y * 2 }
    let longer = |a: i64, b: i64| -> i64 {
        let sum = a + b
        return sum
    }
    let one = pick(|c| { c > 0 })
    let two = pick(|d, e| { d < e })
    let called = twice(4)
    let through = longer(1, 2)

    # nothing says what z is, and what reads it is not asked
    let unknown = |z| { z + 1 }

    return 0
