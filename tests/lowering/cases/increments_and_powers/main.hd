# Record 0077, stage 4, step 1: 'i++' gives what i held and '++i' what it
# holds now; a negative power is 1 / (a ** -b) truncated, so 0 except for a
# base of 1 or -1 (record 0057). Each line adds one bit: 63 when all hold.
def main : i32
    let result = 0
    let i = 5
    let before = i++
    let after = ++i

    if before == 5 and after == 7 and i == 7:
        result = result | 1

    let j = 3
    let down = j--

    if down == 3 and j == 2 and --j == 1:
        result = result | 2

    if 2 ** -1 == 0:
        result = result | 4

    if 1 ** -5 == 1:
        result = result | 8

    if (0 - 1) ** -3 == -1 and (0 - 1) ** -4 == 1:
        result = result | 16

    let base : u8 = 3

    if base ** 5 == 243 and base ** 6 == 217:
        result = result | 32

    return result
