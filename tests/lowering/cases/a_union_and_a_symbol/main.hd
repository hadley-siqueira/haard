# Record 0064: a union is C's, every field at its start, its field with a
# value the one alive when it is made, its methods called directly. Record
# 0041: a symbol is the address of one entry per name, so two of one name are
# one address and 'as char*' reads its text.

union Bits:
    whole : u32
    low : u8 = 5

    def first : u8
        return low

def main : i32
    let b : Bits
    let bits = 0

    if b.first() == 5:
        bits = bits | 1

    b.whole = 258

    if b.low == 2:
        bits = bits | 2

    let s = :ready

    if s == :ready and s != :other and (s as char*)[0] == 'r':
        bits = bits | 4

    return bits
