def as_written : i32
    let a = 1
    return a

def a_literal_takes_the_return_type : u8
    return 200

def a_literal_that_does_not_fit : u8
    return 300

def a_float_where_an_integer_was_promised : i32
    return 2.5

def a_name_of_another_type : i32
    @a : f64
    return a

def what_a_call_gives_back : f64
    return a_name_of_another_type(1.0)

def deep_inside_a_block : i32
    let a = 1
    if a < 2:
        while a < 2:
            return 2.5
    return a
