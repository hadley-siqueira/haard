# The last part of 'for a; b; c:' was typed by nothing until 2026-09-03, so a
# call with the wrong arguments passed in silence there while the same line
# inside the body was reported. It is written for what it does, like an
# expression on a line of its own -- and it was missed because it is not one:
# a block holds statements and this hangs off the loop's head.
#
# The golden is three errors and not four. The **head** is not checked here on
# purpose: an assignment there declares, and a declaration's initialiser
# belongs to the TypeCollector's second pass, which already reported it.
def takes_int : i32
    @a : i32
    return a

def main : i32
    let n = 0

    for i = 0; i < 3; takes_int(2.5):
        n = n + 1

    for j = takes_int(2.5); n < 9; n++:
        n = n + 1

    for k = 0; k < 3; k++, takes_int(1, 2):
        n = n + 1

    return n
