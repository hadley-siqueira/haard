# Record 0061, for a literal. It has to become a declaration before the
# statement, like a template string, and in the same places that would change
# what the program means -- so it is taken apart in the same way: the loop's
# condition moves into the body, and a short circuit becomes a branch.
def total : i32
    @xs : Array<i32>&
    return 0

# a global is a binding too, and the emitter builds one where it is bound
let global = [1, 2]

def main : i32
    let n = 3
    let ok = true

    # built once before the loop instead of every turn
    while total([1, 2]) < n:
        n = n - 1

    # built even when the left already decided
    if ok and total([3, 4]) > 0:
        n = 0

    if ok or total([5, 6]) > 0:
        n = 0

    # and the two that were always safe, and are left as they were: a
    # condition runs once, and the left of a short circuit runs whatever the
    # right does
    if total([7, 8]) > 0:
        n = 0

    if total([9, 10]) > 0 and ok:
        n = 0

    return n
