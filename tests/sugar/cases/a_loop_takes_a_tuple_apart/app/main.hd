# Record 0067: 'for (k, (v, _)) in xs' walks a name of its own, and the body
# starts with a 'let' per name out of it. The type phase makes each of those
# a reference -- the sugar pass marks them, and the golden of this case shows
# only the shape.

def main : i32
    let xs : (i32, (bool, f64))[1] = {(1, (true, 2.5))}

    for (k, (v, _)) in xs:
        k += 1

    return 0
