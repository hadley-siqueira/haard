    # ..#..
    elif c == '!':
        return "..#....#....#....#....#.........#.."

    return ""

# every glyph this font knows, so that the check below can walk them
let ALPHABET : char* = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 -.:!"

def length_of : i32
    @text : char*
    let n = 0

    while text[n] != '\0':
        n = n + 1

    return n

# Every glyph is exactly 35 characters of '#' and '.', which is the one thing
# that cannot be seen by reading the file: a row of four or six looks right
# and draws wrong. The program runs this before it draws anything
def font_is_sound : bool
    let i = 0

    while ALPHABET[i] != '\0':
        let ink = glyph_of(ALPHABET[i])

        if length_of(ink) != GLYPH_WIDTH * GLYPH_HEIGHT:
            return false

        i = i + 1

    return true

# One character, its top-left corner at (x, y), each of its pixels drawn as a
# square of 'scale' by 'scale' so a 5x7 font can be read at any size
def draw_char : void
    @image : Image*
    @x : i32
    @y : i32
    @c : char
    @scale : i32
    @colour : Colour

    let ink = glyph_of(c)

    if length_of(ink) != GLYPH_WIDTH * GLYPH_HEIGHT:
        return

    let row = 0

    while row < GLYPH_HEIGHT:
        let column = 0

        while column < GLYPH_WIDTH:
            if ink[row * GLYPH_WIDTH + column] == '#':
                filled_rectangle(image,
                                 x + column * scale,
                                 y + row * scale,
                                 scale, scale, colour)

            column = column + 1

        row = row + 1

# a run of them, one blank column of the same scale between each
def draw_text : void
    @image : Image*
    @x : i32
    @y : i32
    @text : char*
    @scale : i32
    @colour : Colour

    let i = 0
    let pen = x

    while text[i] != '\0':
        draw_char(image, pen, y, text[i], scale, colour)
        pen = pen + (GLYPH_WIDTH + 1) * scale
        i = i + 1

# how wide that run would be, so a caller can centre it
def text_width : i32
    @text : char*
    @scale : i32

    let n = length_of(text)

    if n == 0:
        return 0

    return n * (GLYPH_WIDTH + 1) * scale - scale
