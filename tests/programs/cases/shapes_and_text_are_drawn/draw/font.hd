# draw/font.hd -- text, from a bitmap.
#
# One fixed size and nothing else: every glyph is 5 wide and 7 tall, written
# as a run of 35 characters, row by row, where '#' is ink and anything else is
# not. A string literal is a 'char*' and a 'char*' is indexed, so the font
# needs no array literal and no data section -- it is thirty-odd string
# literals and a lookup.
#
# The comment above each one is the glyph as it reads, and the string under it
# is those seven rows run together. 'font_is_sound' below walks every glyph
# and checks it is exactly 35 characters, so a miscounted row is a failing
# test and not a smeared letter.
import ppm.image
import draw.canvas

let GLYPH_WIDTH : i32 = 5
let GLYPH_HEIGHT : i32 = 7

# The ink of one glyph, row by row, or the empty string when this font has no
# such character. A caller that draws an unknown character draws nothing
def glyph_of : char*
    @c : char

    # .###.
    # #...#
    # #...#
    # #####
    # #...#
    # #...#
    # #...#
    if c == 'A':
        return ".###.#...##...#######...##...##...#"

    # ####.
    # #...#
    # #...#
    # ####.
    # #...#
    # #...#
    # ####.
