    # #####
    # ....#
    # ...#.
    # ..#..
    # .#...
    # .#...
    # .#...
    elif c == '7':
        return "#####....#...#...#...#....#....#..."

    # .###.
    # #...#
    # #...#
    # .###.
    # #...#
    # #...#
    # .###.
    elif c == '8':
