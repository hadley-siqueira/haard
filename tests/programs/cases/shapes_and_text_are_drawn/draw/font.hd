    elif c == ' ':
        return "..................................."

    # .....
    # .....
    # .....
    # #####
    # .....
    # .....
    # .....
    elif c == '-':
        return "...............#####..............."

    # .....
    # .....
    # .....
    # .....
    # .....
    # .##..
    # .##..
    elif c == '.':
        return "..........................##...##.."

    # .....
    # .##..
    # .##..
    # .....
    # .##..
    # .##..
    # .....
