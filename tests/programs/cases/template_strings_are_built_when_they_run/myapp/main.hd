# Record 0061: a template string -- and an unbound array literal -- is built
# before the statement it is written in, and where that would change when it
# runs, the statement is first rewritten into the branch or the loop it
# already is. Four places: the right of 'and' and of 'or', a loop's condition
# and a C shaped 'for''s step, and an 'elif''s condition.
#
# What is checked is WHEN each '${}' runs, and nothing about how: every
# interpolation below calls 'seen', which writes into a log, and each check
# compares the log. So the program means the same thing whatever the compiler
# lowers it into -- C++ today, an intermediate representation later.
#
# Its exit status is the number of checks that failed.

class Log:
    text : String
    calls : i32

    def init : void
        calls = 0

    # the value it is given, after writing it down
    def seen : i32
        @value : i32

        calls += 1
        text.append("[${value}]")

        return value

def check : i32
    @what : String
    @ok : bool

    print(what)

    if ok:
        println(": ok")
        return 0

    println(": FAILED")
    return 1

def says : bool
    @s : String&
    @answer : bool

    return answer

# one, whatever it is given: a step that has to build its argument
def one : i32
    @s : String&

    return 1

def length_of : i32
    @s : String&

    return s.length()

def main : i32
    let failures = 0

    # ---- the right of 'and' is built only when the left is true

    let log = Log()
    let no = false
    let yes = true

    if no and says("${log.seen(1)}", true):
        failures += 1

    failures += check("'and' with a false left builds nothing: ${log.calls}",
                      log.calls == 0)

    if yes and says("${log.seen(2)}", true):
        log.seen(3)

    failures += check("'and' with a true left builds it: ${log.text}",
                      log.text == "[2][3]")

    # ---- the right of 'or' is built only when the left is false

    let log_or = Log()

    if yes or says("${log_or.seen(1)}", true):
        log_or.seen(2)

    if no or says("${log_or.seen(3)}", false):
        log_or.seen(4)

    failures += check("'or' builds its right only after a false left: ${log_or.text}", log_or.text == "[2][3]")

    # ---- a chain: each right runs only when the ones before let it

    let log_chain = Log()
    let answer = (no and says("${log_chain.seen(1)}", true)
                  or says("${log_chain.seen(2)}", true)
                  and says("${log_chain.seen(3)}", false))

    failures += check("a chain of three builds the last two: ${log_chain.text}",
                      log_chain.text == "[2][3]" and not answer)

    # ---- a 'while' condition is built every turn, with that turn's values

    let log_while = Log()
    let turns = 0

    while length_of("${log_while.seen(turns)}") == 1 and turns < 3:
        turns += 1

    failures += check("a 'while' condition is built every turn: ${log_while.text}",
                      log_while.text == "[0][1][2][3]")

    # ---- a 'for' condition and its step, with a 'continue' in the body

    let log_for = Log()
    let bodies = 0

    for i = 0; log_for.seen(i) < 4; i = i + one("${log_for.seen(10 + i)}"):
        if i == 1:
            continue

        bodies += 1

    # condition, body, step, condition... and the 'continue' at 1 still
    # reaches the step
    failures += check("a 'for' builds its step after every turn: ${log_for.text}",
                      log_for.text == "[0][10][1][11][2][12][3][13][4]"
                      and bodies == 3)

    # ---- an 'elif' condition is built only when the 'if' was false

    let log_elif = Log()
    let branch = 0

    for k = 0; k < 2; k += 1:
        if k == 0:
            branch += 1
        elif says("${log_elif.seen(k)}", true):
            branch += 10

    failures += check("an 'elif' is built only when it is asked: ${log_elif.text}",
                      log_elif.text == "[1]" and branch == 11)

    # ---- an array literal follows the same rule

    let log_array = Log()
    let xs : i32[] = [0]

    if no and [log_array.seen(1)].length() > 0:
        failures += 1

    while [log_array.seen(xs.length())].length() == 1 and xs.length() < 3:
        xs.add([9][0])

    failures += check("an array literal is built where it runs: ${log_array.text}",
                      log_array.text == "[1][2][3]")

    # ---- a closure of one expression still gives that expression back when
    # the expression builds a String: the String is made in front of it, and
    # the body is still the one expression the source wrote

    let tens : i32[] = [4, 50]
    let widths = tens.map(|n| { length_of("${n * 10}") })

    failures += check("a closure that builds a String gives back: ${widths[0]} ${widths[1]}",
                      widths[0] == 2 and widths[1] == 3)

    return failures
