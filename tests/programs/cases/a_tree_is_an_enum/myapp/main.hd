# A binary search tree whose **node is an enum** -- record 0043 -- walked by
# recursive functions that are all one 'switch'.
#
# It is the shape a sum type exists for: a tree is either a leaf or a node
# with a value and two subtrees, and there is no null, no sentinel and no
# 'is_leaf' flag. The compiler knows which of the two a value is, and a
# 'switch' that forgets one is an error.
#
# Three things about this program are the point:
#
#   **recursion is written with a pointer**. 'Node : (i32, Tree*, Tree*)'
#   rather than 'Tree' by value, which has no size -- Hadley, 2026-09-08:
#   nothing allocates behind the author's back.
#
#   **a capture is a reference** into the value being switched over, so
#   '*t = Tree.Node(...)' turns a leaf into a node in place, and 'insert(left,
#   value)' passes the subtree pointer itself rather than a copy of it.
#
#   **a bare 'Node(...)' would not mean this enum here.** The prelude carries
#   'class Node<T>' for the List, and a name in scope wins over a variant --
#   so the construction is written 'Tree.Node', which is the answer Hadley
#   gave for exactly this case. A **pattern** needs no such thing: it is
#   resolved against the subject and never against the scope, so 'case
#   Node(...)' below is the variant even with the class in view.
#
# Its exit status is the number of checks that failed.

enum Tree:
    Leaf
    Node : (i32, Tree*, Tree*)

def leaf : Tree*
    let made = new Tree

    *made = Tree.Leaf

    return made

def insert : void
    @t : Tree*
    @value : i32

    switch *t:
        case Leaf:
            # a leaf becomes a node with two leaves, in place
            *t = Tree.Node(value, leaf(), leaf())

        case Node(held, left, right):
            if value < held:
                insert(left, value)
            elif value > held:
                insert(right, value)

def contains : bool
    @t : Tree*
    @value : i32

    switch *t:
        case Leaf:
            return false

        case Node(held, left, right):
            if value < held:
                return contains(left, value)

            if value > held:
                return contains(right, value)

            return true

def sum : i32
    @t : Tree*

    switch *t:
        case Leaf:
            return 0

        case Node(held, left, right):
            return held + sum(left) + sum(right)

def count : i32
    @t : Tree*

    switch *t:
        case Leaf:
            return 0

        case Node(held, left, right):
            return 1 + count(left) + count(right)

def depth : i32
    @t : Tree*

    switch *t:
        case Leaf:
            return 0

        case Node(held, left, right):
            let below = depth(left)
            let other = depth(right)

            if other > below:
                below = other

            return 1 + below

# the smallest value, which is the leftmost node: one case answers with what
# it holds and the other with what is under it
def smallest : i32
    @t : Tree*

    switch *t:
        case Leaf:
            return 0

        case Node(held, left, right):
            switch *left:
                case Leaf:
                    return held

                case Node(under, deeper, other):
                    return smallest(left)

def in_order : void
    @t : Tree*
    @into : String&

    switch *t:
        case Leaf:
            pass

        case Node(held, left, right):
            in_order(left, into)
            into.append(held)
            into.append(" ")
            in_order(right, into)

def free_tree : void
    @t : Tree*

    switch *t:
        case Leaf:
            delete t

        case Node(held, left, right):
            free_tree(left)
            free_tree(right)
            delete t

def check : void
    @out : File*
    @what : String
    @ok : bool

    out->write(what)

    if ok:
        out->writeln(": ok")
    else:
        out->writeln(": FAILED")

def main : i32
    let out = console()
    let failures = 0
    let t = leaf()
    let values = {5, 3, 8, 1, 4, 7, 9, 5}
    let i = 0

    # the last 5 is already there and changes nothing, which is the third
    # branch of insert
    while i < 8:
        insert(t, values[i])
        i = i + 1

    let built = count(t) == 7 and sum(t) == 37

    check(out, "seven nodes adding up to ${sum(t)}", built)

    if not built:
        failures = failures + 1

    let shape = depth(t) == 3 and smallest(t) == 1

    check(out, "three deep, smallest is ${smallest(t)}", shape)

    if not shape:
        failures = failures + 1

    let found = (contains(t, 1) and contains(t, 9) and contains(t, 4)
                 and not contains(t, 6) and not contains(t, 0))

    check(out, "what is there is found and what is not is not", found)

    if not found:
        failures = failures + 1

    # and the walk in order, which is what says the tree is a search tree
    let walked : String

    in_order(t, walked)

    let sorted = walked == "1 3 4 5 7 8 9 "

    check(out, "in order: ${walked}", sorted)

    if not sorted:
        failures = failures + 1

    # every node was allocated by 'leaf' and every one is freed here -- the
    # walk deletes the leaves under a node before the node, which is the one
    # order that works and the one a 'switch' makes obvious. Run under
    # AddressSanitizer by hand on 2026-09-08: nothing of the tree leaks
    free_tree(t)

    out->writeln("")
    out->writeln("failures: ${failures}")

    return failures
