# std/list.hd -- List<T>, the class '[T]' is written form for (record 0022).
#
# A doubly linked list: every node points at the next and the previous, and
# the list holds a head and a tail. That is the honest difference from
# Array<T> -- cheap at both ends and cheap to remove from the middle, and O(n)
# to reach the middle at all.
#
# **There is no literal for a List.** It is always built from an Array<T>, or
# from a constant vector written with '{}', or from a pointer and a count
# passed explicitly -- and 'let b : List<i32> = [1, 2, 3]' is the compiler
# choosing the first of those and writing the call.
import std.array

class Node<T>:
    value : T
    next : Node<T>*
    previous : Node<T>*

class List<T>:
    head : Node<T>*
    tail : Node<T>*
    size : i32

    def init : void
        head = null
        tail = null
        size = 0

    # what '[1, 2, 3]' becomes when a List is what was written
    def init : void
        @from : Array<T>&

        head = null
        tail = null
        size = 0

        let i = 0

        while i < from.length():
            push_back(from[i])
            i = i + 1

    # and what '{1, 2, 3}' becomes, and the explicit form
    def init : void
        @from : T*
        @count : i32

        head = null
        tail = null
        size = 0

        let i = 0

        while i < count:
            push_back(from[i])
            i = i + 1

    # record 0031: it owns its nodes, so it says how it is copied
    def init : void
        @other : List<T>&

        head = null
        tail = null
        size = 0

        let walk = other.head

        while walk != null:
            push_back(walk->value)
            walk = walk->next

    def destroy : void
        let walk = head

        while walk != null:
            let after = walk->next

            delete walk
            walk = after

    def length : i32
        return size

    def is_empty : bool
        return size == 0

    def push_back : void
        @value : T

        let made = new Node<T>

        made->value = value
        made->next = null
        made->previous = tail

        if tail == null:
            head = made
        else:
            tail->next = made

        tail = made
        size = size + 1

    def push_front : void
        @value : T

        let made = new Node<T>

        made->value = value
        made->previous = null
        made->next = head

        if head == null:
            tail = made
        else:
            head->previous = made

        head = made
        size = size + 1

    # Record 0034, and Hadley 2026-09-06: yes. It walks from the head, so it
    # is O(n) and a loop over 'l[i]' is O(n squared) -- that is the author's
    # to know and not the language's to forbid
    def operator[] : T&
        @i : i32

        let walk = head
        let at = 0

        while at < i:
            walk = walk->next
            at = at + 1

        return walk->value

    # Record 0057: what 'x in l' asks. Generic for the reason Array's is, and
    # it follows the links rather than counting up through 'l[i]', which would
    # be O(n squared) for the same answer
    def contains<U> : bool
        @value : U

        let walk = head

        while walk != null:
            if walk->value == value:
                return true

            walk = walk->next

        return false

    # Record 0040, and this is why there is a cursor per container: it
    # follows the link the list is made of, so walking one is O(n) and not
    # the O(n squared) a loop over 'l[i]' would be
    def iterator : ListCursor<T>
        let cursor : ListCursor<T>

        cursor.at = head

        return cursor

    # Comparing two of these is NOT here, and its absence is the decision.
    #
    # A method of a generic class is instantiated **with the class**, so an
    # 'equals' that compares two T made every T ever put in one of these need
    # an 'operator==' -- for a method nobody called. 'List<Token>' over a
    # plain class was *Token has no 'operator=='*, pointing into this file, at
    # a line the reader never opened. Measured 2026-09-09: nothing in the
    # whole repository has ever compared two of these.
    #
    # Where it belongs is a **free generic function**, instantiated per call,
    # which asks nothing of a T nobody compares. Record 0054.


# Record 0040's cursor for a linked list: a node pointer, and 'next' follows
# it. Nothing here indexes anything
class ListCursor<T>:
    at : Node<T>*

    def init : void
        at = null

    def has_next : bool
        return at != null

    def next : T&
        let node = at

        at = at->next

        return node->value
