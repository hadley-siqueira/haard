# Null is zero, and a pointer to a local reaches that local.
def set : void
    @where : i32*
    @value : i32

    *where = value

def main : i32
    let p : i32* = null
    let x = 5
    let total = 0

    if p == null:
        total += 1

    p = &x

    if p != null:
        total += 2

    set(p, 40)
    total += x

    return total
