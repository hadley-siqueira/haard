# A generic enum, 2026-09-30. Each of these was a failure the day before --
# 'Option<i32>.Some(3)' had no type, 'Option<i32>.None' named the generic
# nobody instantiated, 'Option.Some(3)' matched nothing -- and a clone made
# while inferring had variants with no types at all.
#
# A variant written without the enum's arguments is found in a clone: the one
# the context expects, or the one its arguments solve. The exit status is 42,
# and every other answer is checked on the way.
enum Option<T>:
    Some : T
    None

enum Seq<T>:
    Cons : (T, Seq<T>*)
    Nil

def or_else<T> : T
    @o : Option<T>
    @fallback : T

    switch o:
        case Some(x):
            return x

        case None:
            return fallback

    return fallback

def first_even : Option<i32>
    @xs : i32[4]

    for i = 0; i < 4; i++:
        if xs[i] % 2 == 0:
            return Some(xs[i])

    return None

def sum : i32
    @s : Seq<i32>*

    switch *s:
        case Cons(head, tail):
            return head + sum(tail)

        case Nil:
            return 0

    return 0

def main : i32
    let written = Option<i32>.Some(3)          # the clone, named
    let nothing = Option<i32>.None
    let solved = Option.Some(true)             # T from the argument
    let wide : Option<i64> = Some(5)           # T from the context: i64
    let empty : Option<i64> = Option.None      # and the generic named bare
    let odd = {1, 3, 5, 7}
    let some_even = {1, 3, 4, 7}

    if or_else(written, 0) != 3 or or_else(nothing, 9) != 9:
        return 1

    if not or_else(solved, false):
        return 2

    if or_else(wide, 0) != 5 or or_else(empty, 6) != 6:
        return 3

    if or_else(first_even(odd), 0 - 1) != 0 - 1:
        return 4

    let nil : Seq<i32> = Nil
    let two = Cons(10, &nil)
    let one = Cons(12, &two)

    return or_else(first_even(some_even), 0) + sum(&one) + 16
