# Hadley 2026-11-03: a sign is looser than the '**' right after its operand,
# so '-2 ** 2' is '-(2 ** 2)', the way '-x²' is read. Only a sign, and only a
# '**' that follows its operand directly: '-x | 1' is still '(-x) | 1'.
#
# One bit per line that has to come out right.

def main : i32
    let x = 3
    let bits = 0

    if -2 ** 2 == -4:
        bits = bits | 1

    if (-2) ** 2 == 4:
        bits = bits | 2

    if -x ** 2 == -9 and - -x ** 2 == 9:
        bits = bits | 4

    # the tower still folds from the right: -(2 ** (1 ** 3))
    if -2 ** 1 ** 3 == -2:
        bits = bits | 8

    # a power's exponent can carry its own sign: 2 ** -(1 ** 2)
    if 2 ** -1 ** 2 == 0:
        bits = bits | 16

    if -x | 1 == -3:
        bits = bits | 32

    return bits
