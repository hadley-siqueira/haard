# An enum whose variant carries a class is compared by that class's own
# 'operator==' (record 0034: it is a method, never C++'s operator). A class
# that wrote none leaves nothing to compare with -- and the enum is still a
# perfectly good enum, so the refusal belongs at the **comparison** and not at
# the declaration. 'an_enum_that_carries_a_class' is the same shape without
# the last two lines, and it emits.
class Word:
    size : i32

    def init : void
        @from : char*

        size = 0

        while from[size] != '\0':
            size = size + 1

enum Shape:
    Nothing
    Dot : Word

def main : i32
    let one = Shape.Dot("hi")
    let two = Shape.Dot("hi")

    if one == two:
        return 1

    return 0
