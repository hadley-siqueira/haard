# Record 0083, answer 9: an Array checks in its own operator[], through the
# intrinsic that is the instruction a fixed array's index is. Copies of the real
# std/. Its capacity is 4, so only the check stops the read at 2.
import std.array
import std.low_io

def say : void
    @text : char*

    let i = 0

    while text[i] != '\0':
        __io_write(__io_stdout(), text[i])
        i += 1

    __io_write(__io_stdout(), '\n')

def main : i32
    let values : i32[] = [10, 20]
    let last : i32 = 1
    let past : i32 = 2

    if values[last] == 20:
        say("last")

    return values[past]
