# Record 0018, amended 2026-09-06: a reference IS the thing it names, which is
# C++'s semantics. Until then a 'T&' could not be read as a value ANYWHERE --
# six places, every one of them below -- so giving one back from a function
# was pointless, and 'operator[]' returning one could not have worked.
#
# The other half of it is that assigning to a reference writes THROUGH it,
# which is why 'through = 5' below changes what 'held' names and not what
# 'through' refers to.
#
# A seventh place joined the six on 2026-09-08: the **address** of one. '&r'
# over a 'T&' was a 'T&*' -- a type nothing can take -- and it is the idiom a
# table is written with, a method handing out a pointer into its own storage.
# C++ needed nothing for it; only the type was wrong.

class Cell:
    value : i32

    def init : void
        value = 0

    def slot : i32&
        return value

def takes : i32
    @n : i32
    return n

def main : i32
    let held = 40
    let through : i32& = held
    let c : Cell

    c.slot() = 9

    # 1. a binding
    let bound : i32 = through

    # 2. arithmetic
    let sum = through + 2

    # 3. a call
    let passed = takes(through)

    # 4. a comparison
    let equal = through == 40

    # 5. an assignment out of one
    let copied = 0

    copied = through

    # 6. and writing through one, which changes what it names
    through = 5

    # 7. the address of one, which is the address of what it names. Both
    # shapes: a reference bound to a name, and the one 'slot()' gives back
    let pointed = &through
    let into = &c.slot()

    *into = *into + 1

    if not equal:
        return 1

    if held != 5:
        return 2

    if *pointed != 5:
        return 3

    # 40 + 42 + 40 + 0 + 10 = 132
    return bound + sum + passed + held - 5 + c.slot()
