# std/option.hd -- Option<T>, a value that may not be there.
#
# Record 0043's enum with a payload, and generic (record 0043, amended
# 2026-09-30): 'Some(3)' is an Option<i32>, 'None' is whichever Option the
# context expects, and 'Option<i32>.None' says it out loud where nothing does.
#
# Its API is methods on the enum, Hadley 2026-09-30: an enum may write them,
# and they are a struct's -- never virtual.
#
# 'unwrap' takes the value out and stops the program when there is none, with
# a message on the error stream (Hadley, 2026-10-07): it is std.low_io's
# '__abort'. 'unwrap_or' says what to give instead, and a 'switch' takes the
# value out where both cases are written.
import std.low_io

# what 'unwrap' says before it stops the program
def __unwrapped_none : void
    let message = "error: unwrap called on a None\n"
    let err = __io_stderr()
    let i = 0

    # what was printed before comes out before the message, as it was written
    __io_flush(__io_stdout())

    while message[i] != '\0':
        __io_write(err, message[i])
        i += 1

    __abort()

enum Option<T>:
    Some : T
    None

    def is_some : bool
        switch *this:
            case Some(value):
                return true

            case None:
                return false

        return false

    def is_none : bool
        return not is_some()

    # the value, and the program stops when there is none. The loop never runs
    # twice -- '__abort' does not come back -- and is what tells the compiler
    # this method cannot reach its end without a value
    def unwrap : T
        while true:
            switch *this:
                case Some(value):
                    return value

                case None:
                    __unwrapped_none()

    # the value, or 'fallback' when there is none
    def unwrap_or : T
        @fallback : T

        switch *this:
            case Some(value):
                return value

            case None:
                return fallback

        return fallback

    # what 'f' makes of the value, and None stays None. A GENERIC method, so
    # an Option nobody maps carries none of it (record 0055)
    def map<U> : Option<U>
        @f : T& -> U

        switch *this:
            case Some(value):
                return Option<U>.Some(f(value))

            case None:
                return Option<U>.None

        return Option<U>.None
