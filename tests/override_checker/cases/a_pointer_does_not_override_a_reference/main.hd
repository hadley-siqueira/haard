# covariance is between two pointers or between two references, never across
# the two: a caller written against a Base& is not holding a pointer, and
# nothing about deriving from Base changes that
class Base:
    tag : i32

class Derived(Base):
    extra : i32

class Shape:
    base_pointer : Base*
    base_reference : Base&

    def one : Base&
        return base_reference

    def two : Base*
        return base_pointer

class Square(Shape):
    derived_pointer : Derived*
    derived_reference : Derived&

    def one : Derived*
        return derived_pointer

    def two : Derived&
        return derived_reference
