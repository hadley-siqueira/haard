# hasm -- text in, a static ELF out. Record 0084, step 1.
#
#   hasm <input.s> -o <output>
#
# Writes nothing when anything was refused. The output is not marked executable,
# since Haard has no way to yet: 'chmod +x' is the caller's, as the record says.
import hasm.assembler
import hasm.elf

def main : i32
    @args : String[]

    if args.length() != 4 or args[2] != "-o":
        errors()->writeln("usage: hasm <input.s> -o <output>")
        return 2

    let assembler : Assembler

    if not assembler.assemble(args[1].text()):
        errors()->writeln("hasm: cannot read ${args[1]}")
        return 2

    if assembler.failed:
        return 1

    let writer : ElfWriter

    writer.image = &assembler.image
    writer.write(args[3].text())

    return 0
