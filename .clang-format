# Style of the Haard compiler (hdc).
# Reproduces the conventions already used in src/. Requires clang-format >= 17.
---
Language: Cpp
BasedOnStyle: LLVM

# --- Indentation ---
IndentWidth: 4
UseTab: Never
TabWidth: 4
ContinuationIndentWidth: 4
NamespaceIndentation: All        # the contents of 'namespace haard' are indented
IndentAccessModifiers: true      # 'public:' at +1 level, members at +2
IndentCaseLabels: true           # 'case' indented inside the 'switch'
IndentPPDirectives: None

# --- Braces and blocks (K&R / 1TBS) ---
BreakBeforeBraces: Attach
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
InsertBraces: true               # always braces, even for a one-statement body

# --- Blank lines ---
MaxEmptyLinesToKeep: 1                    # never two blank lines in a row
KeepEmptyLinesAtTheStartOfBlocks: false   # nothing right after '{'
SeparateDefinitionBlocks: Always          # exactly 1 line between functions
EmptyLineBeforeAccessModifier: LogicalBlock
EmptyLineAfterAccessModifier: Never
InsertNewlineAtEOF: true
KeepEmptyLinesAtEOF: false

# --- Spacing ---
PointerAlignment: Left           # Context* context
ReferenceAlignment: Left         # std::vector<Token>&
DerivePointerAlignment: false
SpaceAfterCStyleCast: true       # (TokenKind) kind
SpaceBeforeParens: ControlStatements
SpacesInParentheses: false
SpaceBeforeRangeBasedForLoopColon: true
Cpp11BracedListStyle: true       # {"import", TK_IMPORT} with no inner spaces

# --- Line breaking ---
ColumnLimit: 100                 # the longest line in the project today is 88
BreakBeforeBinaryOperators: All  # '||' at the start of the continuation line
AlignAfterOpenBracket: Align
AlignOperands: DontAlign        # continuation at +4, not aligned to the operand
BinPackParameters: true
BinPackArguments: true

# --- Preserve manual decisions ---
SortIncludes: Never              # the project's include order is not alphabetical
FixNamespaceComments: false      # the project does not use '} // namespace haard'
ReflowComments: false
